{
  "$schema": "https://sidebandstudio.github.io/GitHub-Reskin/schemas/theme-v1.schema.json",
  "schemaVersion": 1,
  "name": "Choom Circuit",
  "inspiredBy": "Cyberpunk: Edgerunners",
  "author": "sidebandstudio",
  "version": "1.0.0",
  "description": "Acid lime, cold signal blue and a quiet afterimage. Original geometry.",
  "tags": [
    "anime",
    "neon",
    "dark"
  ],
  "base": "dark",
  "colors": {
    "background": "#091312",
    "text": "#f0f7ed",
    "accent": "#d5ff35",
    "contribution": "#d5ff35"
  },
  "overrides": {
    "surface": "#142622",
    "inset": "#060d0c",
    "mutedText": "#aac2b7",
    "link": "#7de9f5",
    "controlBorder": "#6b8179",
    "primaryBackground": "#d5ff35",
    "primaryText": "#10170a",
    "syntax": {
      "comment": "#aac2b7"
    }
  },
  "fonts": {
    "accent": "rajdhani"
  },
  "effects": {
    "rail": {
      "shape": "notch",
      "opacity": 0.18,
      "thickness": 2
    },
    "scanlines": {
      "opacity": 0.015,
      "spacing": 6
    },
    "echo": {
      "offset": 3,
      "durationMs": 160,
      "opacity": 0.12
    }
  },
  "flavor": {
    "enabled": true,
    "locale": "en",
    "slots": {
      "profile.pinned.heading": "Preem picks",
      "profile.tag": "//choom",
      "error.notFound.caption": "This route went dark. Try a familiar path.",
      "contributions.caption": "A year of gigs, one contribution at a time."
    }
  },
  "contributions": {
    "levels": [
      "#24372f",
      "#4e8c60",
      "#78b94d",
      "#a9dc3b",
      "#d5ff35"
    ]
  }
}
