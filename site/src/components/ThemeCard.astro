---
// A gallery card: the shared preview's capture of this theme on the same pinned repository and
// contribution graph, the anime title first, then the theme's name. Preview updates the hero in
// place; View in preview is an ordinary link to the theme page that also works without JavaScript.
// The card's geometry never depends on the selection, so nothing moves under the pointer.
import Icon from "./Icon.astro";
import { href, themePath } from "../lib/site.mjs";

interface Props { theme: any; selected: boolean }
const { theme, selected } = Astro.props;
const shot = theme.captures.card;
---
<li class:list={["card", { "is-selected": selected }]} data-card={theme.slug}>
  <div class="card-shot">
    <img src={shot.src} width={shot.width} height={shot.height} alt={`${theme.name} on the whoisaldo profile's pinned repository and contribution graph`} loading="lazy" decoding="async" />
  </div>
  <div class="card-body">
    <h3 class="card-title">{theme.title}</h3>
    <p class="card-name">{theme.anime ? theme.name : "Classic theme"}</p>
    {theme.description && <p class="card-desc">{theme.description}</p>}
    {theme.advancedCss && <p class="badge">Advanced CSS · Bundled and reviewed</p>}
    <div class="card-actions">
      <button class="btn btn-small card-preview needs-js" type="button" data-theme={theme.slug} aria-pressed={selected ? "true" : "false"}>
        <span class="when-off">Preview</span><span class="when-on"><Icon name="check" /> Previewing</span><span class="sr-only"> {theme.title}</span>
      </button>
      <a href={`${href(themePath(theme.slug))}#preview`} data-jump={theme.slug}>View in preview<span class="sr-only">: {theme.title}</span></a>
    </div>
  </div>
</li>
