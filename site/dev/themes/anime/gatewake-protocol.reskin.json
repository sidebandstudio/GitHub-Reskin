{
  "$schema": "https://sidebandstudio.github.io/GitHub-Reskin/schemas/theme-v1.schema.json",
  "schemaVersion": 1,
  "name": "Gatewake Protocol",
  "author": "sidebandstudio",
  "version": "1.0.0",
  "description": "Deep navy, icy cyan and crisp gate-like brackets frame GitHub as a clean progress dashboard.",
  "inspiredBy": "Solo Leveling",
  "tags": [
    "anime",
    "dark"
  ],
  "base": "dark",
  "colors": {
    "background": "#071523",
    "text": "#e9f4ff",
    "accent": "#65d7ff",
    "contribution": "#65d7ff"
  },
  "overrides": {
    "surface": "#0f2438",
    "inset": "#040d17",
    "raised": "#192735",
    "hover": "#22303d",
    "mutedText": "#9fb8ce",
    "link": "#82dcff",
    "border": "#31516b",
    "controlBorder": "#9fb8ce",
    "accentMuted": "#163446",
    "primaryBackground": "#17668a",
    "primaryText": "#ffffff",
    "focus": "#9fb8ce",
    "selectionBackground": "#17668a",
    "selectionText": "#ffffff",
    "success": "#6ad6bc",
    "danger": "#ff92a5",
    "warning": "#f3cc78"
  },
  "fonts": {
    "accent": "rajdhani"
  },
  "effects": {
    "seal": {
      "shape": "brackets",
      "size": 32,
      "opacity": 0.4
    },
    "glow": {
      "strength": 0.18
    },
    "grid": {
      "opacity": 0.02,
      "size": 24
    }
  },
  "flavor": {
    "enabled": true,
    "locale": "en",
    "slots": {
      "profile.pinned.heading": "Selected gates",
      "profile.activity.heading": "Progress log",
      "profile.organizations.heading": "Guild outposts",
      "profile.tag": "// gate view",
      "error.notFound.caption": "This gate has no destination.",
      "empty.pinned.caption": "Room for a first expedition.",
      "empty.issues.caption": "No records in this view.",
      "contributions.caption": "A year of progress, counted in real contributions."
    }
  },
  "contributions": {
    "levels": [
      "#162e43",
      "#2e7494",
      "#2981a8",
      "#329dc7",
      "#65d7ff"
    ]
  }
}
