{
  "$schema": "https://sidebandstudio.github.io/GitHub-Reskin/schemas/theme-v1.schema.json",
  "author": "sidebandstudio",
  "base": "dark",
  "colors": {
    "accent": "#ffcf4a",
    "background": "#0c3153",
    "contribution": "#ffe0a0",
    "text": "#fff2d7"
  },
  "contributions": {
    "levels": [
      "#29354a",
      "#a78547",
      "#c7a153",
      "#e3bc68",
      "#ffe0a0"
    ]
  },
  "description": "Ocean blue, warm gold and an original chart route bring a sense of open-sea adventure to GitHub.",
  "effects": {
    "glow": {
      "strength": 0.1
    },
    "rail": {
      "opacity": 0.26,
      "shape": "route",
      "thickness": 2
    },
    "seal": {
      "opacity": 0.35,
      "shape": "compass",
      "size": 28
    }
  },
  "flavor": {
    "enabled": true,
    "locale": "en",
    "slots": {
      "contributions.caption": "A year at sea, charted one contribution at a time.",
      "empty.issues.caption": "No routes on this chart.",
      "empty.pinned.caption": "A shelf for future finds.",
      "error.notFound.caption": "No island at these coordinates. Return to known waters.",
      "profile.activity.heading": "Voyage log",
      "profile.organizations.heading": "Harbor outposts",
      "profile.pinned.heading": "Prized finds",
      "profile.tag": "// chart room"
    }
  },
  "fonts": {
    "accent": "fraunces"
  },
  "inspiredBy": "One Piece",
  "name": "Sunward Voyage",
  "overrides": {
    "accentMuted": "#334a52",
    "border": "#7d8da2",
    "controlBorder": "#8e9cae",
    "danger": "#ffa79a",
    "focus": "#f7d992",
    "hover": "#294863",
    "inset": "#091b33",
    "link": "#8fcff0",
    "mutedText": "#b5becd",
    "primaryBackground": "#ffcf4a",
    "primaryText": "#172438",
    "raised": "#1f405e",
    "selectionBackground": "#ffcf4a",
    "selectionText": "#172438",
    "success": "#9cd3a5",
    "surface": "#174365",
    "warning": "#f3cf84"
  },
  "schemaVersion": 1,
  "tags": [
    "anime",
    "dark"
  ],
  "version": "1.0.0"
}
