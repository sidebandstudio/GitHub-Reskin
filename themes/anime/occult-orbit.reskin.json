{
  "$schema": "https://sidebandstudio.github.io/GitHub-Reskin/schemas/theme-v1.schema.json",
  "author": "sidebandstudio",
  "base": "dark",
  "colors": {
    "accent": "#f68cc6",
    "background": "#1a1020",
    "contribution": "#f68cc6",
    "text": "#fff0fa"
  },
  "contributions": {
    "levels": [
      "#33213b",
      "#9a527c",
      "#b25687",
      "#c86696",
      "#f68cc6"
    ]
  },
  "description": "Plum-black panels, pink signals and a small orbit give GitHub a paranormal-club atmosphere.",
  "effects": {
    "echo": {
      "durationMs": 180,
      "offset": 5,
      "opacity": 0.16
    },
    "orbit": {
      "count": 2,
      "opacity": 0.15,
      "shape": "ellipse"
    },
    "paper": {
      "opacity": 0.045,
      "scale": 8,
      "texture": "halftone"
    }
  },
  "flavor": {
    "enabled": true,
    "locale": "en",
    "slots": {
      "contributions.caption": "A year of sightings, one contribution at a time.",
      "empty.issues.caption": "No sightings in this view.",
      "empty.pinned.caption": "A quiet shelf for future sightings.",
      "error.notFound.caption": "No signal. Try another frequency.",
      "profile.activity.heading": "Signal log",
      "profile.organizations.heading": "Club outposts",
      "profile.pinned.heading": "Selected sightings",
      "profile.tag": "// signal club"
    }
  },
  "fonts": {
    "accent": "bungee"
  },
  "inspiredBy": "Dandadan",
  "name": "Occult Orbit",
  "overrides": {
    "accentMuted": "#3d243b",
    "border": "#5d3e67",
    "controlBorder": "#c6a7c7",
    "danger": "#ff9c98",
    "focus": "#c6a7c7",
    "hover": "#352b3a",
    "inset": "#100a15",
    "link": "#feb0da",
    "mutedText": "#c6a7c7",
    "primaryBackground": "#9c286d",
    "primaryText": "#ffffff",
    "raised": "#2c2231",
    "selectionBackground": "#9c286d",
    "selectionText": "#ffffff",
    "success": "#bdd96a",
    "surface": "#2a1a31",
    "warning": "#f3d16e"
  },
  "schemaVersion": 1,
  "tags": [
    "anime",
    "dark"
  ],
  "version": "1.0.0"
}
