{
  "manifest_version": 3,
  "name": "GitHub Reskin",
  "description": "Anime-inspired and classic themes for GitHub, including the contribution graph. Changes only your own browser view.",
  "icons": {
    "16": "pages/icons/icon-16.png",
    "32": "pages/icons/icon-32.png",
    "48": "pages/icons/icon-48.png",
    "128": "pages/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "content/lifecycle/boot.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "GitHub Reskin",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "pages/icons/icon-16.png",
      "32": "pages/icons/icon-32.png",
      "48": "pages/icons/icon-48.png",
      "128": "pages/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "pages/settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/alegreya/alegreya-700.woff2",
        "assets/fonts/alegreya/alegreya.woff2",
        "assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible-700.woff2",
        "assets/fonts/atkinson-hyperlegible/atkinson-hyperlegible.woff2",
        "assets/fonts/barlow-condensed/barlow-condensed-700.woff2",
        "assets/fonts/barlow-condensed/barlow-condensed.woff2",
        "assets/fonts/barlow/barlow-500.woff2",
        "assets/fonts/barlow/barlow-600.woff2",
        "assets/fonts/barlow/barlow-700.woff2",
        "assets/fonts/barlow/barlow.woff2",
        "assets/fonts/bebas-neue/bebas-neue.woff2",
        "assets/fonts/bungee/bungee.woff2",
        "assets/fonts/cinzel/cinzel.woff2",
        "assets/fonts/cormorant-garamond/cormorant-garamond-600.woff2",
        "assets/fonts/cormorant-garamond/cormorant-garamond.woff2",
        "assets/fonts/fraunces/fraunces-700.woff2",
        "assets/fonts/fraunces/fraunces.woff2",
        "assets/fonts/ibm-plex-sans/ibm-plex-sans-500.woff2",
        "assets/fonts/ibm-plex-sans/ibm-plex-sans-600.woff2",
        "assets/fonts/ibm-plex-sans/ibm-plex-sans-700.woff2",
        "assets/fonts/ibm-plex-sans/ibm-plex-sans.woff2",
        "assets/fonts/josefin-sans/josefin-sans-700.woff2",
        "assets/fonts/josefin-sans/josefin-sans.woff2",
        "assets/fonts/nunito-sans/nunito-sans-700.woff2",
        "assets/fonts/nunito-sans/nunito-sans.woff2",
        "assets/fonts/orbitron/orbitron.woff2",
        "assets/fonts/oxanium/oxanium.woff2",
        "assets/fonts/rajdhani/rajdhani-700.woff2",
        "assets/fonts/rajdhani/rajdhani.woff2",
        "assets/fonts/roboto-condensed/roboto-condensed-700.woff2",
        "assets/fonts/roboto-condensed/roboto-condensed.woff2",
        "assets/fonts/source-sans-3/source-sans-3-600.woff2",
        "assets/fonts/source-sans-3/source-sans-3-700.woff2",
        "assets/fonts/source-sans-3/source-sans-3.woff2",
        "assets/fonts/space-grotesk/space-grotesk.woff2"
      ],
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*"
      ]
    }
  ]
}
